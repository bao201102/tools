{
  "name": "nub-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "copy-static-deps": "node scripts/copy-static-deps.js",
    "predev": "npm run copy-static-deps",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "generate-version": "node scripts/generate-version.js",
    "prebuild": "npm run copy-static-deps && npm run generate-sitemap && npm run generate-version",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/prerender.js && node scripts/build-sw.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "highlight.js": "^11.10.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.14.0",
    "marked": "^12.0.0",
    "mermaid": "^11.0.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.10"
  }
}
